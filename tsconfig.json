{
  // The VitePress site configuration, type-checked and linted against the `vitepress` types.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["docs/.vitepress/config.ts"]
}
